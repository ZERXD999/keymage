# คัดลอกไฟล์นี้เป็น ".env" แล้วแก้ค่า (ไฟล์ .env ห้ามส่งให้ใคร/ห้ามอัปโหลดขึ้น GitHub)

PORT=3000

# ที่อยู่ที่ "เพื่อนเปิดเกมได้จริง" — ใช้สร้างลิงก์ในอีเมลรีเซ็ตรหัสผ่าน
# เล่นวงเดียวกัน: http://192.168.1.50:3000   |   ใช้ Cloudflare Tunnel/ngrok: https://xxxx.trycloudflare.com
# ถ้าไม่ตั้ง จะใช้ IP ในวง LAN ของเครื่องนี้อัตโนมัติ
BASE_URL=

# ---- ตั้งค่าส่งอีเมล (ถ้าเว้นว่าง ระบบจะพิมพ์ลิงก์รีเซ็ตในหน้าต่างเซิร์ฟเวอร์แทน ใช้ทดสอบได้) ----
# ตัวอย่าง Gmail: เปิดยืนยัน 2 ขั้นตอน แล้วสร้าง "รหัสผ่านแอป" (App password) 16 หลักที่ https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="KeyMage <your.address@gmail.com>"

# ถ้ารันหลัง Cloudflare Tunnel / reverse proxy ให้ตั้งเป็น 1 เพื่อให้ระบบกันสแปมเห็น IP จริงของผู้เล่น
# TRUST_PROXY=1
